# Account creation is deliberately disabled until SMTP and approved documents exist.
NODE_ENV=production
PUBLIC_ORIGIN=https://YOUR-APPLICATION-DOMAIN
ACCOUNTS_ENABLED=false
PORT=3000
# Configure only after verifying the trusted reverse-proxy topology.
TRUST_PROXY_HOPS=0
PGHOST=YOUR-PRIVATE-DATABASE-IP
PGPORT=5432
PGDATABASE=YOUR-DATABASE-NAME
PGUSER=YOUR-APPLICATION-DATABASE-USER
PGPASSWORD=
PG_POOL_MAX=5
# disable is for the private network. Public connections must use verify-full.
PG_SSL_MODE=disable
PG_SSL_CA_FILE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
SESSION_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
